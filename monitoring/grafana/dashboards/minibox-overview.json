{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "minibox-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (method, status) (rate(http_requests_total[1m]))", "legendFormat": "{{method}} {{status}}", "refId": "A" }],
      "title": "HTTP requests per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "minibox-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }],
      "title": "HTTP request latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "minibox-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 1e-9)", "legendFormat": "average", "refId": "A" }],
      "title": "HTTP request latency average",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["minibox"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "MiniBox overview",
  "uid": "minibox-overview",
  "version": 1
}
