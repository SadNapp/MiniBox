# Copy this file to .env and replace every placeholder before starting Compose.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
GRAFANA_USER=replace-with-a-grafana-admin-username
GRAFANA_PASSWORD=replace-with-a-strong-grafana-password
SIMULATION_USER_PASSWORD=replace-with-a-strong-simulation-account-password
